# SplitApp - ortam degiskenleri
#
# Bu dosya SADECE degisken ISIMLERINI belgeler; gercek degerler asla buraya
# yazilmaz. Yerel gelistirme icin bu dosyayi ".env.local" olarak kopyalayip
# degerleri doldur. .env.local git'e girmez (.gitignore).

# ----------------------------------------------------------------------
# Veritabani (Neon)
# ----------------------------------------------------------------------
# Uygulamanin kullandigi veritabani. Yerelde gelistirme veritabani,
# Vercel'de production veritabani.
DATABASE_URL=

# Playwright testlerinin yazdigi AYRI veritabani. DATABASE_URL ile ayni
# olmamali: e2e/db-cleanup.ts her kosuda bu veritabanini bosaltiyor, ikisi
# ayni olsaydi gercek verini silerdi (kod bu durumda calismayi reddediyor).
E2E_DATABASE_URL=

# ----------------------------------------------------------------------
# Clerk (kimlik dogrulama)
# ----------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk panelinde webhook endpoint'i olusturunca verilen imza anahtari.
# Bu olmadan /api/webhooks/clerk butun istekleri reddeder (guvenli varsayilan).
CLERK_WEBHOOK_SIGNING_SECRET=

# ----------------------------------------------------------------------
# E2E test kullanicilari
# ----------------------------------------------------------------------
# Clerk'te olusturulmus uc test kullanicisi. E-postalar "+clerk_test" icermeli:
# Clerk bu adreslere gercek posta gondermez ve dogrulama kodu her zaman 424242
# olur - testlerin gelen kutusuna ihtiyaci kalmaz.
E2E_CLERK_USER_1_EMAIL=
E2E_CLERK_USER_1_PASSWORD=
E2E_CLERK_USER_2_EMAIL=
E2E_CLERK_USER_2_PASSWORD=
E2E_CLERK_USER_3_EMAIL=
E2E_CLERK_USER_3_PASSWORD=

# ----------------------------------------------------------------------
# Sentry (hata takibi) - opsiyonel
# ----------------------------------------------------------------------
# DSN bos birakilirsa Sentry hic devreye girmez. Yerelde bilerek bos
# birakiyoruz ki kendi denemelerimiz hata listesini kirletmesin.
NEXT_PUBLIC_SENTRY_DSN=

# Asagidakiler yalnizca kaynak haritalarini yuklemek icin gerekli (Vercel).
# SENTRY_AUTH_TOKEN yoksa yukleme tamamen atlanir.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
