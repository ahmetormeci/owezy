// SplitApp - Prisma Schema
//
// NOT: Bu dosya henuz migration'a donusturulmedi ("prisma migrate dev" calistirilmadi)
// ve veritabanina hicbir baglanti kurulmadi. Sadece veri modelinin tanimidir.
//
// Asagidaki kurallar Prisma'nin sema dilinde DOGRUDAN ifade edilemez.
// Ilk migration olusturulduktan sonra migration SQL dosyasina ELLE eklenecekler
// (her biri, ilgili modelin yaninda da ayrica not dusulmustur):
//   1. GroupMember(groupId, userId) uzerinde PARTIAL UNIQUE INDEX (yalnizca leftAt IS NULL icin)
//   2. CHECK (amount > 0)                -> Expense.amount
//   3. CHECK (shareAmount >= 0)          -> ExpenseParticipant.shareAmount
//   4. CHECK (fromUserId <> toUserId)    -> Settlement
//   5. CHECK (useCount <= maxUses)       -> GroupInvite
//   6. Cross-table currency tutarliligi  -> Expense.currency / Settlement.currency == Group.currency
//   7. SUM(ExpenseParticipant.shareAmount) = Expense.amount (trigger veya uygulama katmani)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum GroupRole {
  OWNER
  MEMBER
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
}

enum ExpenseCategory {
  FOOD
  TRANSPORT
  ACCOMMODATION
  SHOPPING
  BILLS
  ENTERTAINMENT
  OTHER
}

enum ExpenseEditAction {
  UPDATE
  DELETE
  RESTORE
}

enum NotificationType {
  EXPENSE_ADDED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_RECORDED
  SETTLEMENT_CANCELLED
  // Eskiden GROUP_INVITE idi. Bizim davetler link tabanli oldugu icin
  // "davet edildin" diye bir alici yok; anlamli olan olay katilimin kendisi.
  MEMBER_JOINED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id          String    @id @default(uuid()) @db.Uuid

  // @unique (Faz 25.1). Better Auth kimligi e-postadan cozuyor; kisit olmadan
  // ayni adrese birden fazla satir dusebiliyor - nitekim DUSMUSTU: E2E
  // veritabaninda uc test kullanicisinin her biri iki kez vardi. Sebebi
  // Clerk'e ozguydu: orada kullanici yeniden yaratilinca clerkId degisiyor
  // ve "clerkId ile ara, yoksa olustur" ikinci bir satir aciyordu. O sutun
  // 25.7'de dustu ama kisit KALICI - e-posta kimligin kendisi.
  email       String    @unique

  // Better Auth'un cekirdek alani. Faz 25 oncesinde karsiligi yoktu cunku
  // dogrulamayi Clerk yapiyordu ve biz sonucunu hic saklamiyorduk.
  emailVerified Boolean @default(false)

  displayName String
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Arayuz dili tercihi ("tr" / "en").
  //
  // NULLABLE ve VARSAYILANSIZ, bilerek: @default("tr") olsaydi mevcut her
  // kullanicinin Turkce SECTIGINI iddia ederdi, oysa hicbiri secmedi.
  // null = "tercih belirtmedi" ve bu gercek bir bilgi - okuma sirasi
  // cerez -> hesap -> varsayilan (ADR-019), null olan hesap sirayi bozmuyor.
  //
  // Degerin dogrulanmasi uygulamada: normalizeLocale() beyaz liste uyguluyor.
  // Kolon String cunku dil listesi buyudukce migration gerektirmesin.
  locale String?

  // Kullanici GERCEKTEN bir fotograf yukledi mi?
  //
  // NEDEN AYRI BIR ALAN: Clerk, fotograf yuklememis kullaniciya da bir
  // image_url veriyordu - kendi urettigi bas-harf gorseli. avatarUrl'e bakip
  // "varsa fotografi bas" deseydik, fotografi olanlar gercek yuz, olmayanlar
  // CLERK'IN tasarimiyla gorunurdu; bizim bas-harf dairelerimizle yan yana
  // iki ayri gorsel sistem olurdu.
  //
  // FAZ 25.7 SONRASI IKISINI DE YAZAN YOK: Clerk gitti, yeni kayit akisi
  // fotograf sormuyor. Sutunlar duruyor cunku eski satirlarda deger var ve
  // bir profil fotografi ozelligi geldiginde ayni ayrim yine gerekecek
  // (bkz. components/person-avatar.tsx).
  //
  // Nullable: "bilmiyorum" diyebilmek icin. null, false gibi davraniyor
  // (bas harf gosteriliyor).
  hasImage Boolean?

  // Bu kullanicinin olusturdugu gruplar
  createdGroups Group[] @relation("GroupCreatedBy")

  // Bu kullanicinin aktif/gecmis grup uyelikleri
  memberships GroupMember[] @relation("GroupMemberUser")

  // Bu kullanicinin baskalarini davet ettigi uyelik kayitlari
  invitedMembers GroupMember[] @relation("GroupMemberInvitedBy")

  // User <-> Expense arasinda UC ayri iliski var (paidBy / createdBy / deletedBy)
  // Her biri ayri @relation adiyla ayristirilmistir (asagida Expense modeline bakiniz).
  expensesPaid    Expense[] @relation("paidBy")
  expensesCreated Expense[] @relation("createdBy")
  expensesDeleted Expense[] @relation("deletedBy")

  expenseParticipations ExpenseParticipant[]

  // User <-> Settlement arasinda DORT ayri iliski var
  settlementsSent      Settlement[] @relation("fromUser")
  settlementsReceived  Settlement[] @relation("toUser")
  settlementsCreated   Settlement[] @relation("createdBy")
  settlementsCancelled Settlement[] @relation("cancelledBy")

  // Better Auth'un yonettigi kayitlar. Cascade BILEREK: bunlar finansal
  // kayit degil, oturum artifaktlari - "finansal kayitlar fiziksel olarak
  // silinmez" kurali onlari baglamiyor. Zaten hesap silme SOFT delete
  // (deletedAt) oldugu icin bu cascade pratikte hic tetiklenmiyor.
  sessions Session[]
  accounts Account[]

  expenseEdits  ExpenseEdit[]  @relation("changedBy")
  groupInvites  GroupInvite[]  @relation("invitedBy")
  notifications Notification[]

  @@index([email])
}

model Group {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?   @db.Text
  currency    String    @db.Char(3)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy   User          @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  invites     GroupInvite[]

  @@index([createdById])
  @@index([deletedAt])
}

model GroupMember {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @db.Uuid
  userId      String    @db.Uuid
  role        GroupRole @default(MEMBER)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  invitedById String?   @db.Uuid

  group     Group @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user      User  @relation("GroupMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy User? @relation("GroupMemberInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  // NOT (Prisma'da ifade edilemez -> custom SQL migration gerekir):
  //   CREATE UNIQUE INDEX group_member_active_unique
  //     ON "GroupMember" ("groupId", "userId") WHERE "leftAt" IS NULL;
  //   Amac: bir kullanicinin bir grupta AYNI ANDA yalnizca bir aktif uyeligi olabilir.
  //   (Zaman icinde ayrilip tekrar katilirsa birden fazla satir olusabilir, bu istenen davranistir.)

  @@index([groupId])
  @@index([userId])
}

model Expense {
  id          String          @id @default(uuid()) @db.Uuid
  groupId     String          @db.Uuid
  paidById    String          @db.Uuid
  createdById String          @db.Uuid
  deletedById String?         @db.Uuid
  description String          @db.Text
  // Aramada karsilastirilan katlanmis bicim: Turkce harfler ASCII karsiligina
  // iner ve metin kucultulur ("Isik" -> "isik", "ışık" -> "isik").
  //
  // Veritabaninda GENERATED ALWAYS ... STORED (bkz. migration
  // 20260813..._add_expense_description_fold). Prisma bunu bilmiyor ve
  // bilmesine gerek de yok: hicbir yazma yolu bu alani "data" icinde
  // gondermedigi surece degeri Postgres uretiyor. Bu yuzden NULLABLE -
  // zorunlu olsaydi Prisma create'te deger isterdi ve uretilmis kolona
  // yazmaya calismak hata verirdi.
  descriptionFold String?     @db.Text
  amount      Int
  currency    String          @db.Char(3)
  category    ExpenseCategory @default(OTHER)
  splitType   SplitType
  expenseDate DateTime        @db.Date
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  // Optimistic locking sayaci (ADR-032). Okuyan istemci bu degeri de alir ve
  // yazarken geri gonderir; sunucu "WHERE id = ? AND version = ?" ile yazar.
  // Arada baskasi yazdiysa sayac artmistir, hicbir satir eslesmez ve istek
  // 409 ile reddedilir - sessizce uzerine yazmak yerine.
  //
  // NEDEN updatedAt DEGIL: updatedAt'i Postgres degil Prisma yaziyor, yani
  // uygulama sunucusunun saati. Vercel'de istekler farkli ornekler uzerinden
  // gectigi icin saat geri gidebilir. Ayrica JSON'a cikarken milisaniyeye
  // yuvarlaniyor, veritabaninda mikrosaniye duruyor. Sayac ikisini de bilmez.
  version     Int             @default(1)

  group        Group                @relation(fields: [groupId], references: [id], onDelete: Restrict)
  paidBy       User                 @relation("paidBy", fields: [paidById], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  deletedBy    User?                @relation("deletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  participants ExpenseParticipant[]
  edits        ExpenseEdit[]

  // NOT (Prisma'da ifade edilemez -> custom SQL migration gerekir):
  //   CHECK (amount > 0)
  // NOT (cross-table kural, CHECK ile yazilamaz -> trigger veya uygulama katmani):
  //   currency, bu harcamanin bagli oldugu Group.currency ile ayni olmalidir.

  @@index([groupId])
  @@index([groupId, deletedAt])
  @@index([expenseDate])
  @@index([paidById])
}

model ExpenseParticipant {
  id          String   @id @default(uuid()) @db.Uuid
  expenseId   String   @db.Uuid
  userId      String   @db.Uuid
  shareAmount Int
  // Kullanicinin GIRDIGI yuzde (basis point: 10000 = %100). shareAmount bunun
  // sonucudur, tersi degil - ve yuvarlama yuzunden sonuctan girdiye her zaman
  // geri donulemez. Yalnizca splitType = PERCENTAGE olan harcamalarda dolu;
  // EQUAL/EXACT'ta yuzde diye bir sey YOK, o yuzden null (0 degil).
  // Bu kolondan onceki kayitlarda da null - o satirlar icin yuzde hic saklanmadi.
  basisPoints Int?
  createdAt   DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  // NOT (Prisma'da ifade edilemez -> custom SQL migration gerekir):
  //   CHECK (shareAmount >= 0)
  // NOT (coklu satir toplami, CHECK ile yazilamaz -> trigger veya uygulama katmani):
  //   SUM(shareAmount) WHERE expenseId = X, ilgili Expense.amount'a HER ZAMAN tam esit olmalidir.
  //   Bu kural oncelikle uygulama katmaninda (tek transaction icinde) garanti edilecek.

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
}

model Settlement {
  id            String    @id @default(uuid()) @db.Uuid
  groupId       String    @db.Uuid
  fromUserId    String    @db.Uuid
  toUserId      String    @db.Uuid
  amount        Int
  currency      String    @db.Char(3)
  note          String?   @db.Text
  settledAt     DateTime  @db.Date
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())
  cancelledAt   DateTime?
  cancelledById String?   @db.Uuid

  group       Group @relation(fields: [groupId], references: [id], onDelete: Restrict)
  fromUser    User  @relation("fromUser", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser      User  @relation("toUser", fields: [toUserId], references: [id], onDelete: Restrict)
  createdBy   User  @relation("createdBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy User? @relation("cancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  // NOT (Prisma'da ifade edilemez -> custom SQL migration gerekir):
  //   CHECK (amount > 0)
  //   CHECK (fromUserId <> toUserId)
  // NOT (cross-table kural -> trigger veya uygulama katmani):
  //   currency, bu settlement'in bagli oldugu Group.currency ile ayni olmalidir.

  @@index([groupId])
  @@index([groupId, cancelledAt])
  @@index([fromUserId])
  @@index([toUserId])
}

model ExpenseEdit {
  id           String            @id @default(uuid()) @db.Uuid
  expenseId    String            @db.Uuid
  action       ExpenseEditAction
  previousData Json?             @db.JsonB
  newData      Json?             @db.JsonB
  changedById  String            @db.Uuid
  changedAt    DateTime          @default(now())

  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  changedBy User    @relation("changedBy", fields: [changedById], references: [id], onDelete: Restrict)

  // Bu tablo immutable bir audit log'dur: satirlar hicbir zaman
  // UPDATE veya DELETE edilmez, yalnizca INSERT edilir.
  // action = UPDATE  -> previousData ve newData ikisi de dolu
  // action = DELETE  -> yalnizca previousData dolu
  // action = RESTORE -> previousData (silinmis hal) ve newData (geri yuklenen hal) dolu

  @@index([expenseId])
  @@index([changedById])
}

model GroupInvite {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @db.Uuid
  invitedById String    @db.Uuid
  tokenHash   String    @db.VarChar(128)
  expiresAt   DateTime
  maxUses     Int       @default(1)
  useCount    Int       @default(0)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Restrict)
  invitedBy User  @relation("invitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  // Guvenlik notu: tokenHash, ham davet token'inin hash'idir (orn. SHA-256).
  // Ham token veritabaninda ASLA saklanmaz; kullaniciya yalnizca link olusturulurken bir kez gosterilir.
  //
  // NOT (Prisma'da ifade edilemez -> custom SQL migration gerekir):
  //   CHECK (useCount <= maxUses)

  @@unique([tokenHash])
  @@index([groupId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  payload   Json?            @db.JsonB
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Okunmamis sayisini bulmak icin (zil ikonundaki rakam).
  @@index([userId, readAt])
  // Listeyi yeniden eskiye siralamak icin. Bu olmasa her listeleme, kullanicinin
  // TUM bildirimlerini okuyup bellekte siralamak zorunda kalirdi.
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Better Auth'un yonettigi tablolar (Faz 25.1).
//
// Bu uc model ELLE YAZILMADI: "@better-auth/cli generate" uretti, sonra iki
// yerde bizim semamiza uyarlandi:
//   1. Tablo adlari PascalCase (uretici kucuk harf @@map koyuyordu)
//   2. Butun id ve FK sutunlari @db.Uuid (semanin geri kalani boyle)
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid

  // Kimligi VEREN taraf ("local:credential", ya da sosyal saglayicilarda
  // saglayicinin adresi). Better Auth bunu ZORUNLU yaziyor.
  //
  // BU ALAN ILK BASTA UNUTULDU ve sebebi kayda deger: sema
  // "@better-auth/cli@1.4.21" ile uretilmisti, kutuphane ise 1.7.1. CLI
  // kurulurken "no longer supported" uyarisi verdi, gecildi. Sonuc: ESKI
  // bir surumun semasi. Kayit formu ilk denemede "Unknown argument issuer"
  // ile dustu.
  //
  // DOGRU KAYNAK CALISMA ZAMANI: @better-auth/core'daki getAuthTables()
  // kendi ayarlarimizla cagrilip dort modelin tamami karsilastirildi.
  // Eksik olan yalnizca buydu.
  issuer                String

  accountId             String
  providerId            String
  userId                String    @db.Uuid
  // Parolayla giriste parola HASH'i burada durur (providerId = "credential").
  // Sosyal saglayicilarda bunun yerine token alanlari dolar - o is 25.x'e
  // ertelendi, ama tablo bugunden hazir.
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Hiz siniri sayaclari. Better Auth yonetiyor, biz hic yazmiyoruz.
 *
 * NEDEN VERITABANI, VARSAYILAN "memory" DEGIL: Vercel'de her serverless
 * ornegi kendi bellegini tasiyor ve ornekler kisa omurlu. Bellekteki sayac
 * her yeni ornekte sifirdan basliyor, yani "10 saniyede 3 giris denemesi"
 * kurali pratikte cok daha fazlasina izin veriyordu. Kural degil, SAYDIGI
 * YER yanlisti.
 *
 * ALANLAR CALISMA ZAMANINDAN ALINDI - @better-auth/core'daki getAuthTables()
 * kendi ayarlarimizla cagrilip liste karsilastirildi. 25.4'te sema bir CLI
 * surumunden uretilmisti ve Account.issuer atlanmisti; ayni hataya iki kez
 * dusulmedi.
 *
 * lastRequest BigInt VE BU ZORUNLU: deger Date.now(), yani milisaniye
 * (~1,77 x 10^12). Prisma'nin Int'i 32 bit INTEGER'dir ve bu sayi ORAYA
 * SIGMAZ. Kutuphanenin kendi kodundaki "typeof data.lastRequest === bigint"
 * kontrolu de bunu soyluyor.
 *
 * Kullaniciya BAGLI DEGIL: anahtar "IP + yol" ve limit henuz kimligi
 * bilinmeyen isteklere de uygulanmali - zaten korumaya calistigi sey giris
 * denemesi.
 */
/**
 * /api/v1 YAZMA uclarinin hiz siniri sayaclari. Better Auth'un RateLimit
 * tablosundan AYRI ve bu ayrilik zorunlu, tercih degil.
 *
 * NEDEN AYNI TABLOYA YAZILAMIYOR: Better Auth kendi tablosunu buduyor
 * (rate-limiter/index.mjs, deleteExpiredRows) ve budama esigini YALNIZCA
 * KENDI kurallarindan hesapliyor:
 *     const cutoff = now - longestObservedWindow * 1000;
 *     db.deleteMany({ model, where: [{ field: "lastRequest", op: "lt", ... }] })
 * Bizim penceremiz onunkilerden uzun oldugu icin satirlarimiz sessizce
 * silinirdi - yani sinir zaman zaman hic uygulanmazdi. Bulunmasi en zor
 * hata turu.
 *
 * BUDAMAYA GEREK YOK: anahtar kullaniciya bagli, yani satir sayisi kullanici
 * sayisiyla sinirli. Better Auth'unki "IP + yol" oldugu icin sinirsiz
 * buyuyebiliyor ve budamak zorunda.
 *
 * SABIT PENCERE, kayan degil: pencere dolunca sayac sifirlaniyor. Kayan
 * pencere daha adil ama daha fazla satir ve daha karmasik sorgu demek;
 * amacimiz kacak bir istemciyi durdurmak, adaleti gram gram olcmek degil.
 */
model ApiRateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  windowStart BigInt
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  // E-posta adresi gibi "neyi dogruluyoruz" degeri. Tek seferlik kodlar
  // (emailOTP) da burada duruyor - kullaniciya bagli DEGIL, cunku kod
  // henuz kimligi kanitlanmamis birine gonderiliyor.
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
