# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...ama .env.example yalnizca degisken ISIMLERINI belgeler, deger icermez.
!.env.example

# vercel
.vercel

# claude code local settings
.claude/

# manuel API testleri icin lokal istek govdeleri (dev veritabanina ozgu ID'ler icerir)
/test-requests/

# playwright: kayitli oturumlar (giris bilgisi icerir) ve calisma ciktilari
/e2e/.auth/
/test-results/
/playwright-report/
/blob-report/

# typescript
*.tsbuildinfo
next-env.d.ts

# expo / react native
# ORNEK DOSYA ISTISNASI: yukaridaki ".env*" kalibi mobile/.env.local.example'i
# de yakaliyor. O dosya SIR ICERMIYOR, hangi degiskenlerin gerektigini anlatan
# tek yer - temiz bir klonda bulunmasi sart.
!mobile/.env.local.example

# Kurallar mobile/.gitignore icinde - Expo sablonuyla geliyor ve daha eksiksiz.
# Burada TEKRARLANMIYOR: iki yerde duran ayni kural, zamanla ayrisir.
#
# Dikkat: yukaridaki "/node_modules" satirindaki bastaki egik cizgi KOKU
# isaret ediyor, yani mobile/node_modules ONA dahil degil. Onu kapatan sey
# mobile/.gitignore.
