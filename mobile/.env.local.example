# mobile/.env.local (bu dosyanin kopyasi) GIT'E GIRMEZ.
#
# EXPO_PUBLIC_ onekli degiskenler pakete GOMULUR ve cihazda okunabilir.
# Buraya yalnizca zaten herkese acik olan degerler konur - gizli anahtar asla.

# Clerk yayimlanabilir anahtari. Gelistirmede web ile AYNI development
# ornegini kullaniyoruz: kok .env.local icindeki
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY degerinin aynisi (pk_test_ ile baslar).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Mobilin cagiracagi API. Clerk ornegi ile AYNI olmak zorunda: pk_test_
# kullaniyorsak burasi da development ornegiyle calisan sunucu olmali,
# yani yereldeki "next dev". https://owezy.net pk_live_ bekliyor ve
# test orneginden alinmis bir Bearer'a 401 doner.
#
# iOS Simulator ana makinenin localhost'una erisebiliyor.
# Fiziksel cihazda makinenin LAN adresini yaz (orn. http://192.168.1.20:3000).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
